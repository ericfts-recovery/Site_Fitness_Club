# URL pública do site (sem barra no final). Usada em canonical, sitemap, OG e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.fitnessclubcanoas.com.br

# Google Analytics 4 (opcional). Só carrega após o visitante aceitar cookies de análise.
NEXT_PUBLIC_GA_ID=

# Envio do formulário de aula experimental por e-mail via Resend (https://resend.com)
# Chave secreta: NUNCA expor no front-end (sem prefixo NEXT_PUBLIC_).
RESEND_API_KEY=
# Destinatário dos leads (e-mail da recepção da academia)
LEAD_TO_EMAIL=
# Remetente verificado no Resend, ex.: "Site Fitness Club <site@fitnessclubcanoas.com.br>"
LEAD_FROM_EMAIL=
